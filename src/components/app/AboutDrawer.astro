---
import { translations, LANGS, langPath, type Lang } from '../../lib/i18n';
import AboutContent from '../AboutContent.astro';
import AnalyticsOptOut from '../AnalyticsOptOut.astro';
import githubIcon from '../../icons/github.svg?raw';
import Footer from '../Footer.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<div id="about-overlay"></div>
<!-- Inert while closed: off screen, its controls would still take Tab stops. -->
<div id="about-drawer" role="dialog" aria-modal="true" aria-label={t.aria_about} inert>
  <div id="about-header">
    <div id="about-lang">
      {LANGS.map(l => (
        <a class:list={['lang-btn', { active: lang === l }]} href={langPath(l)}>{l.toUpperCase()}</a>
      ))}
    </div>
    <button id="about-close" aria-label={t.aria_close}>×</button>
  </div>

  <div id="about-body">
    <AboutContent lang={lang} />
  </div>

  <div id="about-links">
    <a href="https://github.com/paultursuru/meridian" target="_blank" rel="noopener" class="about-link github-link">
      <Fragment set:html={githubIcon} />
      GitHub
    </a>
  </div>
  <div id="about-optout">
    <AnalyticsOptOut lang={lang} />
  </div>
  <div id="about-footer">
    <Footer lang={lang} />
  </div>
</div>
