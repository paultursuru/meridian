---
import { translations, LANGS, langPath, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<div id="header">
  <h1>
    <a href={langPath(lang)}>
      <span class="meri">Meridian</span><span class="way">Way</span>
    </a>
  </h1>
  <div id="header-right">
    <!-- The other languages open to the left of the button, over the space
         between it and the logo (langMenu.ts). -->
    <div id="lang-picker">
      <button id="lang-btn" type="button" aria-expanded="false" aria-controls="lang-menu">
        <span class="sr-only">{t.lang_menu} </span>{lang.toUpperCase()}
      </button>
      <ul id="lang-menu" hidden>
        {LANGS.filter(l => l !== lang).map(l => (
          <li><a class="lang-btn" href={langPath(l)} lang={l} hreflang={l}>{l.toUpperCase()}</a></li>
        ))}
      </ul>
    </div>
    <button id="about-btn" aria-label={t.aria_about}>i</button>
  </div>
</div>
<div id="install-banner">
  <span id="install-banner-text"></span>
  <div id="install-banner-actions">
    <button id="install-banner-btn">{t.install_banner_btn}</button>
    <button id="install-banner-close" aria-label={t.aria_close}>×</button>
  </div>
</div>
