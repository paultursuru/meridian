---
// The privacy page, in each language, on the same shell as the content pages.
// Kept out of the index on purpose.
import ContentLayout from './ContentLayout.astro';
import PrivacyContent from '../components/PrivacyContent.astro';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const titles: Record<Lang, string> = {
  fr: 'Confidentialité — MeridianWay',
  de: 'Datenschutz — MeridianWay',
  it: 'Privacy — MeridianWay',
  en: 'Privacy — MeridianWay',
  rm: 'Protecziun da datas — MeridianWay',
};
---
<ContentLayout lang={lang} title={titles[lang]} path="privacy/" noindex translated bodyClass="privacy-page">
  <PrivacyContent lang={lang} />
</ContentLayout>

<!-- Bundled by Astro (not is:inline): the CSP forbids inline scripts. -->
<script>
  import { initAnalyticsOptOut } from '../lib/analyticsOptOut.js';
  initAnalyticsOptOut();
</script>
