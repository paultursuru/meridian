---
import { translations, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  kind: 'sunny' | 'shady';
  active?: boolean;
}

const { lang, kind, active = false } = Astro.props;
const t = translations[lang];
const title = kind === 'sunny' ? t.tab_sunny : t.tab_shady;
const dot = kind === 'sunny' ? 'sun' : 'shade';
---
<div id={`tab-${kind}`} class:list={['tab-pane', { active }]} role="tabpanel" aria-labelledby={`tab-btn-${kind}`}>
  <button class="pane-title" type="button" data-tab={kind}><span class:list={['side-dot', dot]} aria-hidden="true"></span>{title}</button>
  <div class="ratio-wrap">
    <div class="ratio-nums">
      <span class="ratio-shade-num"><span class="side-dot shade" aria-hidden="true"></span>{t.label_shade} <strong id={`${kind}-shade-pct`}></strong></span>
      <span class="ratio-sun-num"><strong id={`${kind}-sun-pct`}></strong> <span class="side-dot sun" aria-hidden="true"></span>{t.label_sun}</span>
    </div>
    <div class="ratio-track">
      <div class="ratio-seg ratio-seg-shade" id={`${kind}-shade-fill`} style="width:0%"></div>
      <div class="ratio-seg ratio-seg-sun" id={`${kind}-sun-fill`} style="width:0%"></div>
    </div>
  </div>
  <div class="ratio-delta" id={`${kind}-delta`}></div>
  <div class="route-details">
    <div class="detail-stats">
      <div class="detail-stat">
        <span class="stat-val" id={`${kind}-dist`}></span>
        <span class="stat-lbl">{t.label_distance}</span>
      </div>
      <div class="detail-stat">
        <span class="stat-val" id={`${kind}-dur`}></span>
        <span class="stat-lbl">{t.label_duration}</span>
      </div>
      <div class="detail-stat" id={`${kind}-elev-stat`} style="display:none">
        <span class="stat-val elev-val" id={`${kind}-elev`}></span>
        <span class="stat-lbl">{t.label_elevation}</span>
      </div>
    </div>
    <div class="detail-split">
      <span class="detail-split-shade"><span class="side-dot shade" aria-hidden="true"></span><span class="split-val" id={`${kind}-shaded-dist`}></span> <span class="split-lbl">{t.split_shade}</span></span>
      <span class="split-sep" aria-hidden="true">·</span>
      <span class="detail-split-sun"><span class="side-dot sun" aria-hidden="true"></span><span class="split-val" id={`${kind}-sun-dist`}></span> <span class="split-lbl">{t.split_sun}</span></span>
    </div>
  </div>
</div>
