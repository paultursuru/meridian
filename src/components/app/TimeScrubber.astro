---
import { translations, type Lang } from '../../lib/i18n';
import eclipseIcon from '../../icons/eclipse-marker.svg?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<div id="time-scrubber">
  <span id="scrubber-time"></span>
  <div id="scrubber-track">
    <button id="scrubber-mark" type="button"><Fragment set:html={eclipseIcon} /></button>
    <input type="range" id="scrubber-range" min="0" max="1439" step="1" aria-label={t.aria_scrubber} />
  </div>
</div>
