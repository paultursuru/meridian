---
import '../styles/main.css';
import { translations, type Lang } from '../lib/i18n';
import AboutContent from '../components/AboutContent.astro';
import targetIcon from '../icons/target.svg?raw';
import arrowIcon from '../icons/arrow.svg?raw';
import calendarClockIcon from '../icons/calendar-clock.svg?raw';
import eclipseIcon from '../icons/eclipse-marker.svg?raw';
import { onboardingQuery } from '../lib/onboarding.js';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const urls: Record<Lang, string> = {
  fr: 'https://meridian-way.ch/',
  de: 'https://meridian-way.ch/de/',
  it: 'https://meridian-way.ch/it/',
  en: 'https://meridian-way.ch/en/',
  rm: 'https://meridian-way.ch/rm/',
};

// The note's copy of the arrow needs its own gradient id: the note comes
// first and starts hidden, and a hidden gradient paints nothing elsewhere.
const noteArrowIcon = arrowIcon.replaceAll('meridianArrowGradient', 'meridianArrowGradientNote');

// The demo is this page's own path plus a search, so it opens in the same
// language, and the button works as a plain link before the script runs.
const onboardingHref =`${new URL(urls[lang]).pathname}?${onboardingQuery({ from: t.onboarding_from, to: t.onboarding_to })}`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{t.title}</title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0e120a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <meta name="description" content={t.meta_description} />
  <link rel="canonical" href={urls[lang]} />
  <link rel="alternate" hreflang="fr" href={urls.fr} />
  <link rel="alternate" hreflang="de" href={urls.de} />
  <link rel="alternate" hreflang="it" href={urls.it} />
  <link rel="alternate" hreflang="en" href={urls.en} />
  <link rel="alternate" hreflang="rm" href={urls.rm} />
  <link rel="alternate" hreflang="x-default" href={urls.fr} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={urls[lang]} />
  <meta property="og:title" content={t.title} />
  <meta property="og:description" content={t.meta_description} />
  <meta property="og:image" content="https://meridian-way.ch/meridian-way-og.png" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "MeridianWay",
    "url": urls[lang],
    "description": t.meta_description,
    "applicationCategory": "TravelApplication",
    "operatingSystem": "Web",
    "inLanguage": ["fr", "de", "it", "en", "rm"],
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "CHF" },
    "author": { "@type": "Person", "url": "https://github.com/paultursuru" }
  })} />
  <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="3ed0ad98-8924-4e14-aa5b-6afe5d3dc7ac" data-domains="meridian-way.ch" data-auto-pageview="false" data-performance="false"></script>
</head>
<body>

<div id="app">
  <div id="header">
    <h1>
      <a href="/">
        <span class="meri">Meridian</span><span class="way">Way</span>
      </a>
    </h1>
    <div id="header-right">
      <div id="sun-info">{t.navbar_tagline}</div>
      <button id="about-btn" aria-label={t.aria_about}>i</button>
    </div>
  </div>
  <div id="install-banner">
    <span id="install-banner-text"></span>
    <div id="install-banner-actions">
      <button id="install-banner-btn">{t.install_banner_btn}</button>
      <button id="install-banner-close" aria-label={t.aria_close}>×</button>
    </div>
  </div>
  <div id="search-panel">
    <div class="route-inputs">
      <div class="input-wrap">
        <label for="inp-start"><span class="input-label">{t.label_start}</span></label>
        <input type="text" id="inp-start" placeholder={t.placeholder_start} />
        <button class="clear-btn" id="clear-start" type="button" title={t.clear_btn_title} aria-label={t.clear_btn_title}>✕</button>
        <button class="geo-btn" id="geo-start" type="button" title={t.geo_btn_title} aria-label={t.geo_btn_title} set:html={targetIcon} />
      </div>
      <button id="swap-btn" type="button" title={t.swap_btn_title} aria-label={t.swap_btn_title}><span class="swap-ico">⇅</span></button>
      <div class="input-wrap">
        <label for="inp-end"><span class="input-label">{t.label_end}</span></label>
        <input type="text" id="inp-end" placeholder={t.placeholder_end} />
        <button class="clear-btn" id="clear-end" type="button" title={t.clear_btn_title} aria-label={t.clear_btn_title}>✕</button>
        <button class="geo-btn" id="geo-end" type="button" title={t.geo_btn_title} aria-label={t.geo_btn_title} set:html={targetIcon} />
      </div>
    </div>
    <div class="depart-row">
      <div class="split-btn">
        <button id="search-btn" type="button">{t.btn_leave_now}</button>
        <button id="depart-toggle" type="button" aria-haspopup="true" aria-expanded="false" title={t.depart_toggle_title} aria-label={t.depart_toggle_title} set:html={calendarClockIcon} />
      </div>
      <!-- One stack under the button: the date popover, then the demo's note,
           which moves up on its own when the popover closes. -->
      <div class="depart-overlays" id="depart-overlays">
        <div class="depart-popover" id="depart-popover" role="dialog" aria-label={t.depart_later_label}>
          <div class="depart-popover-fields">
            <div class="">
              <label for="inp-date"><span class="input-label">{t.label_date}</span></label>
              <input type="date" id="inp-date" />
            </div>
            <div class="">
              <label for="inp-time"><span class="input-label">{t.label_time}</span></label>
              <input type="time" id="inp-time" />
            </div>
          </div>
          <button id="depart-confirm" type="button">{t.btn_search}</button>
        </div>
        <div id="onboarding-note">
          <div class="onboarding-note-arrow" set:html={noteArrowIcon} />
          <p set:html={t.onboarding_description}></p>
          <button id="onboarding-note-close" aria-label={t.aria_close}>×</button>
        </div>
      </div>
    </div>
  </div>
  <div id="map" role="region" aria-label={t.aria_map}>
    <div id="app-description">
      <div id="app-description-arrow" set:html={arrowIcon} />
      <div id="app-description-content">
        <p set:html={t.app_description}></p>
      </div>
      <button id="app-description-close" aria-label={t.aria_close}>×</button>
    </div>
    <div id="map-splash"><span>{t.map_loading}</span></div>
    <a id="onboarding-btn" href={onboardingHref}>{t.onboarding_btn}</a>
    <button id="map-sun-info" type="button" aria-expanded="false" aria-label={t.aria_sun_info}>
      <div id="map-sun-info-row">
        <span id="map-sun-info-human"></span>
        <span id="map-sun-info-chevron" aria-hidden="true"></span>
      </div>
      <div id="map-sun-info-details">
        <span id="map-sun-info-technical"></span>
        <span id="map-sun-info-datetime"></span>
        <span id="map-sun-info-weather"></span>
      </div>
    </button>
  </div>
</div>

<div id="status" role="status" aria-live="polite"></div>

<div id="about-overlay"></div>
<div id="about-drawer" role="dialog" aria-modal="true" aria-label={t.aria_about}>
  <div id="about-header">
    <div id="about-lang">
      <a class:list={['lang-btn', { active: lang === 'fr' }]} href="/">FR</a>
      <a class:list={['lang-btn', { active: lang === 'de' }]} href="/de/">DE</a>
      <a class:list={['lang-btn', { active: lang === 'it' }]} href="/it/">IT</a>
      <a class:list={['lang-btn', { active: lang === 'rm' }]} href="/rm/">RM</a>
      <a class:list={['lang-btn', { active: lang === 'en' }]} href="/en/">EN</a>
    </div>
    <button id="about-close" aria-label={t.aria_close}>×</button>
  </div>

  <div id="about-body">
    <AboutContent lang={lang} />
  </div>

  <div id="about-links">
    <a href="https://github.com/paultursuru/meridian" target="_blank" rel="noopener" class="about-link github-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
      GitHub
    </a>
  </div>
  <div class="footer-links">
    <a href={lang === 'fr' ? '/about' : `/${lang}/about`} class="footer-link">{t.aria_about}</a>
    <span class="footer-link">-</span>
    <a href={lang === 'fr' ? '/privacy' : `/${lang}/privacy`} class="footer-link">{t.about_privacy}</a>
  </div>
</div>

<div id="time-scrubber">
  <span id="scrubber-time"></span>
  <div id="scrubber-track">
    <button id="scrubber-mark" type="button"><Fragment set:html={eclipseIcon} /></button>
    <input type="range" id="scrubber-range" min="0" max="1439" step="1" aria-label={t.aria_scrubber} />
  </div>
</div>

<div id="results" role="status" aria-live="polite">
  <div id="drawer-handle" aria-label={t.aria_drawer_toggle} role="button" tabindex="0">
    <div id="drawer-bar"></div>
  </div>
  <button id="share-btn" title={t.share_btn_title} aria-label={t.share_btn_title}>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
  </button>
  <div id="night-note">
    <p>{t.night_note}</p>
    <button id="night-sunrise-btn" type="button"></button>
  </div>
  <div id="eclipse-note">{t.eclipse_note}</div>
  <div id="grazing-sun-note">{t.grazing_sun_note}</div>
  <div id="single-route-note">{t.single_route_note}</div>
  <div id="tabs" role="tablist">
    <button class="tab-btn shady"  id="tab-btn-shady" data-tab="shady" role="tab" aria-selected="false" aria-controls="tab-shady">{t.tab_shady}</button>
    <button class="tab-btn active" id="tab-btn-sunny" data-tab="sunny" role="tab" aria-selected="true"  aria-controls="tab-sunny">{t.tab_sunny}</button>
  </div>
  <div id="tab-sunny" class="tab-pane active" role="tabpanel" aria-labelledby="tab-btn-sunny">
    <button class="pane-title" type="button" data-tab="sunny">{t.tab_sunny}</button>
    <div class="ratio-wrap">
      <div class="ratio-nums">
        <span class="ratio-shade-num">{t.label_shade} <strong id="sunny-shade-pct"></strong></span>
        <span class="ratio-sun-num"><strong id="sunny-sun-pct"></strong> {t.label_sun}</span>
      </div>
      <div class="ratio-track">
        <div class="ratio-seg ratio-seg-shade" id="sunny-shade-fill" style="width:0%"></div>
        <div class="ratio-seg ratio-seg-sun" id="sunny-sun-fill" style="width:0%"></div>
      </div>
    </div>
    <div class="ratio-delta" id="sunny-delta"></div>
    <div class="route-details">
      <div class="detail-stats">
        <div class="detail-stat">
          <span class="stat-val" id="sunny-dist"></span>
          <span class="stat-lbl">{t.label_distance}</span>
        </div>
        <div class="detail-stat">
          <span class="stat-val" id="sunny-dur"></span>
          <span class="stat-lbl">{t.label_duration}</span>
        </div>
        <div class="detail-stat" id="sunny-elev-stat" style="display:none">
          <span class="stat-val elev-val" id="sunny-elev"></span>
          <span class="stat-lbl">{t.label_elevation}</span>
        </div>
      </div>
      <div class="detail-split">
        <div class="detail-split-shade">
          <span class="split-val" id="sunny-shaded-dist"></span>
          <span class="split-lbl">{t.label_shade}</span>
        </div>
        <div class="detail-split-sun">
          <span class="split-val" id="sunny-sun-dist"></span>
          <span class="split-lbl">{t.label_sun}</span>
        </div>
      </div>
    </div>
  </div>

  <div id="tab-shady" class="tab-pane" role="tabpanel" aria-labelledby="tab-btn-shady">
    <button class="pane-title" type="button" data-tab="shady">{t.tab_shady}</button>
    <div class="ratio-wrap">
      <div class="ratio-nums">
        <span class="ratio-shade-num">{t.label_shade} <strong id="shady-shade-pct"></strong></span>
        <span class="ratio-sun-num"><strong id="shady-sun-pct"></strong> {t.label_sun}</span>
      </div>
      <div class="ratio-track">
        <div class="ratio-seg ratio-seg-shade" id="shady-shade-fill" style="width:0%"></div>
        <div class="ratio-seg ratio-seg-sun" id="shady-sun-fill" style="width:0%"></div>
      </div>
    </div>
    <div class="ratio-delta" id="shady-delta"></div>
    <div class="route-details">
      <div class="detail-stats">
        <div class="detail-stat">
          <span class="stat-val" id="shady-dist"></span>
          <span class="stat-lbl">{t.label_distance}</span>
        </div>
        <div class="detail-stat">
          <span class="stat-val" id="shady-dur"></span>
          <span class="stat-lbl">{t.label_duration}</span>
        </div>
        <div class="detail-stat" id="shady-elev-stat" style="display:none">
          <span class="stat-val elev-val" id="shady-elev"></span>
          <span class="stat-lbl">{t.label_elevation}</span>
        </div>
      </div>
      <div class="detail-split">
        <div class="detail-split-shade">
          <span class="split-val" id="shady-shaded-dist"></span>
          <span class="split-lbl">{t.label_shade}</span>
        </div>
        <div class="detail-split-sun">
          <span class="split-val" id="shady-sun-dist"></span>
          <span class="split-lbl">{t.label_sun}</span>
        </div>
      </div>
    </div>
  </div>
  <div id="weather-note"></div>
  <div id="quality-note"></div>
</div>

<!-- Desktop only: folds the side panel away. A sibling of #results, which
     clips its overflow, so it stays reachable once the panel has slid out. -->
<button id="panel-toggle" type="button" aria-controls="results" aria-expanded="true" title={t.panel_toggle_title} aria-label={t.panel_toggle_title}>
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5L8 12l7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<script>
  import { getSun, getSunTimes, compassDir, makeSunSampler, isGrazingSun, isEclipseWindow, ECLIPSE_2026 } from '../lib/sun.js';
  import { geocode, reverseGeocode }     from '../lib/geocode.js';
  import { buildRoutes }                 from '../lib/routing.js';
  import { routesBbox, fetchBuildings, heightStats, resolveHeightNoteState } from '../lib/buildings.js';
  import { fetchTileBuildings }          from '../lib/tileBuildings.js';
  import { fetchVegetation }             from '../lib/trees.js';
  import { scoreRoute }                  from '../lib/shadow.js';
  import { deciduousLeafFrac }           from '../lib/season.js';
  import { resolveTimeZone, zonedTimeToUtc, formatTimeInZone, dateValueInZone, minutesInZone } from '../lib/timezone.js';
  import { fetchWeather, weatherAt }     from '../lib/weather.js';
  import { preselectTab }                from '../lib/preselect.js';
  import { setStatus, showToast, initTabs, initLayout, showResults, hideResults, setActiveTab, showScrubber, hideScrubber, setScrubberLabel, showQualityNote } from '../lib/ui.js';
  import { initAutocomplete }            from '../lib/autocomplete.js';
  import { buildShareQuery, parseShareQuery } from '../lib/share.js';
  import { TZ_CENTERS } from '../lib/tzCenters.js';
  import { tr, type TranslationKey }     from '../lib/i18n.js';
  import { localDateValue, fmtHm }        from '../lib/helpers.js';
  import { initInstallPrompt, registerServiceWorker, isStandalone, notifySearchSucceeded } from '../lib/pwa.js';
  import { saveLastPosition, getLastPosition } from '../lib/lastPosition.js';
  import { ONBOARDING } from '../lib/onboarding.js';
  import { trackPageview } from '../lib/analytics.js';

  // Absent until Umami's script loads, and for good behind a blocker: always
  // call it through window.umami?.
  declare global {
    interface Window {
      umami?: { track: (event?: string, data?: Record<string, unknown>) => void };
    }
  }

  // Auto page views are off on the tag (see analytics.js): this one is ours.
  trackPageview();

  // Leaflet + MapLibre (~330 KB) get their own chunk: nothing needs them
  // before the map renders, and the splash covers it until then.
  const { initMap, displayRoutes, clearMap, setActiveRoute, setPreviewPin, clearPreviewPin, swapPreviewPins, centerMap, showMyLocation, bboxZoom, fitToBbox, glZoom, queryBuildingFeatures, viewportBbox, viewAt, mapCenter } = await import('../lib/map.js');

  initMap();
  // After initMap: the desktop side panel docks to #map's laid-out offset.
  initLayout();
  // Fires only on a user click that changes the route (setActiveTab is also
  // called by code): where to measure whether the preselect sticks.
  initTabs((type: string) => {
    window.umami?.track('tab_switch', { to: type });
    setActiveRoute(type);
  });
  registerServiceWorker();
  initInstallPrompt();

  window.addEventListener('route-select', (e: Event) => {
    const type = (e as CustomEvent<{ type: string }>).detail.type;
    setActiveTab(type);
    setActiveRoute(type);
  });

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input  = (id: string) => el<HTMLInputElement>(id);
  const button = (id: string) => el<HTMLButtonElement>(id);

  // One listener; each night search rebuilds its target.
  let goToSunrise: () => void = () => {};
  button('night-sunrise-btn').addEventListener('click', () => goToSunrise());

  const sunInfoBtn = button('map-sun-info');
  sunInfoBtn.addEventListener('click', () => {
    const expanded = sunInfoBtn.classList.toggle('expanded');
    sunInfoBtn.setAttribute('aria-expanded', String(expanded));
  });

  function hideAppDescription() {
    el('app-description').classList.add('hidden');
  }
  button('app-description-close').addEventListener('click', hideAppDescription);
  // Closing the note doesn't leave the demo.
  function hideOnboardingNote() {
    el('onboarding-note').classList.remove('on');
  }
  button('onboarding-note-close').addEventListener('click', hideOnboardingNote);

  setDepartureNow();

  // Only drives the ✕ buttons. Search buttons stay enabled on empty fields:
  // one filled without an `input` event (autofill, dictation) must still
  // search, and handleSearch says what's missing.
  function syncInputState() {
    const sVal = input('inp-start').value.trim();
    const eVal = input('inp-end').value.trim();
    input('inp-start').closest('.input-wrap')!.classList.toggle('has-value', !!sVal);
    input('inp-end').closest('.input-wrap')!.classList.toggle('has-value', !!eVal);
  }

  let startAC: ReturnType<typeof initAutocomplete>;
  let endAC:   ReturnType<typeof initAutocomplete>;

  // Bias a lookup towards the other endpoint once resolved, else the map.
  const searchAnchor = (other?: ReturnType<typeof initAutocomplete>) =>
    other?.getPlace() ?? mapCenter();

  startAC = initAutocomplete(input('inp-start'), { onSelect: (p: { lat: number; lng: number }) => { setPreviewPin('start', p); syncInputState(); }, getAnchor: () => searchAnchor(endAC) });
  endAC   = initAutocomplete(input('inp-end'),   { onSelect: (p: { lat: number; lng: number }) => { setPreviewPin('end',   p); syncInputState(); }, getAnchor: () => searchAnchor(startAC) });
  ['inp-start', 'inp-end'].forEach(id => input(id).addEventListener('input', syncInputState));
  syncInputState();

  // Cloud cover (%) above which the sunny/shady distinction stops mattering
  const OVERCAST_PCT = 60;

  // On the map, not the header: it follows the scrubber like the shadows.
  function updateSunInfo(sun: { azDeg: number; altDeg: number }, times: { sunrise: Date; sunset: Date }, timeZone: string, atDate: Date) {
    const badge = el('map-sun-info');
    badge.classList.toggle('day',   sun.altDeg > 0);
    badge.classList.toggle('night', sun.altDeg <= 0);
    badge.classList.add('on');

    const human = sun.altDeg <= 0
      ? tr('night_position', { time: formatTimeInZone(times.sunrise, timeZone) })
      : tr('sun_position', { dir: tr(('dir_' + compassDir(sun.azDeg)) as TranslationKey), time: formatTimeInZone(times.sunset, timeZone) });
    const technical = tr('status_sun', { alt: sun.altDeg.toFixed(1), az: sun.azDeg.toFixed(0) });
    // Built per call: the destination's zone can only go in the constructor.
    // No year: every date shown is within the searched day.
    const dateTimeFmt = new Intl.DateTimeFormat(document.documentElement.lang, {
      timeZone, day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    });
    const datetime = tr('map_datetime', { date: dateTimeFmt.format(atDate) });
    el('map-sun-info-human').textContent = human;
    el('map-sun-info-technical').textContent = technical;
    el('map-sun-info-datetime').textContent = datetime;
  }

  function updateMapWeatherInfo(weather: { cloudCover: number; temperature: number | null } | null) {
    el('map-sun-info-weather').textContent = weather && weather.temperature != null
      ? tr('map_weather', { temp: String(Math.round(weather.temperature)), cloud: String(Math.round(weather.cloudCover)) })
      : '';
  }


  // Bumped by each search and by resetSearch, so a stale search's
  // continuations (vegetation lands after the buttons re-enable) skip the DOM.
  let searchGeneration = 0;

  // Routes are on screen. Stays true while a newer search loads over them.
  let searchShown = false;

  // The search on screen, or loading, is the demo.
  let onboarding = false;
  // The current search pushed its own history entry (not landed on as a link).
  let searchEntryPushed = false;
  // A history.back() of ours, whose popstate must not be taken for the user's.
  let skipNextPop = false;

  // A complete search in the URL marks a search's history entry.
  function urlHasSearch() {
    const q = parseShareQuery(location.search);
    return !!(q.start && q.end);
  }

  // Coded like the ones routing.js and geocode.js raise: translated message
  // for the toast, code for the `search` event.
  type CodedError = Error & { code?: string; role?: string };
  function noRouteError(): CodedError {
    const err: CodedError = new Error(tr('error_no_route'));
    err.code = 'NO_ROUTE';
    return err;
  }

  function setSearchBusy(busy: boolean) {
    button('search-btn').disabled = busy;
    button('depart-toggle').disabled = busy;
    button('depart-confirm').disabled = busy;
  }

  async function handleSearch({ onboarding: demo = false }: { onboarding?: boolean } = {}) {
    const searchStart = performance.now();
    const startQ = input('inp-start').value.trim();
    const endQ   = input('inp-end').value.trim();
    const dateV  = input('inp-date').value;
    const timeV  = input('inp-time').value;

    // Point at the missing field, not just name it.
    if (!startQ || !endQ) {
      // Otherwise the toast stacks on the intro bubble, which already says
      // to fill the fields.
      hideAppDescription();
      showToast(tr('alert_empty'));
      input(startQ ? 'inp-end' : 'inp-start').focus();
      return;
    }

    // Past the check: a refused search must not make the running one stale.
    const mySearchGen = ++searchGeneration;
    onboarding = demo;
    searchEntryPushed = false;
    // Superseded, or undone by Back: checked after each long await.
    const stale = () => mySearchGen !== searchGeneration;
    // Also silences the status writes from inside buildRoutes and the tile pass.
    const searchStatus = (msg: string | null) => { if (!stale()) setStatus(msg); };

    setSearchBusy(true);
    closeDepartPopover();
    hideAppDescription();
    el('onboarding-note').classList.toggle('on', demo);
    // The demo is at a set date: its note points up at the popover showing it.
    if (demo) openDepartPopover({ focus: false });
    el('results').classList.remove('on');
    hideScrubber();

    try {
      searchStatus(tr('status_geocoding'));
      // Same anchor as the autocomplete: typed + Enter resolves where the
      // suggestions would.
      const [startC, endC] = await Promise.all([
        startAC.getPlace() ?? geocode(startQ, { role: 'start', near: searchAnchor(endAC) }),
        endAC.getPlace()   ?? geocode(endQ, { role: 'end', near: searchAnchor(startAC) }),
      ]);

      const midLat = (startC.lat + endC.lat) / 2;
      const midLng = (startC.lng + endC.lng) / 2;

      // Both ends Swiss, since a route could cross the border. A missing
      // countryCode counts as not Swiss.
      const switzerland = startC.countryCode === 'ch' && endC.countryCode === 'ch';

      // The date/time fields are wall-clock time at the route, not the browser.
      const destTz = await resolveTimeZone(midLat, midLng);
      let tDate = new Date();
      if (dateV) {
        tDate = zonedTimeToUtc(`${dateV}T${timeV || '12:00'}`, destTz);
      }

      // Fixed per search (the scrubber stays in the day). Gates the marker and
      // is the denominator for eclipse_jump.
      const eclipseDay = switzerland && dateValueInZone(tDate, destTz) === ECLIPSE_2026.date;

      const sun = getSun(tDate, midLat, midLng);
      // Night: no weather, no shadows, just the shortest route.
      const night = sun.altDeg <= 0;

      // Started now, awaited late. The whole day, hourly, so the scrubber can
      // re-sample it. Null beyond the forecast horizon or on error.
      const weatherP = night ? Promise.resolve(null) : fetchWeather(midLat, midLng, tDate);
      let hourlyWeather: Awaited<typeof weatherP> = null;

      const sunTimes = getSunTimes(tDate, midLat, midLng);

      // SunCalc anchors to the nearest solar transit: a 23:00 search gets that
      // morning's sunrise back, so roll to the next day.
      if (night) {
        let nextSunrise = sunTimes.sunrise > tDate
          ? sunTimes.sunrise
          : getSunTimes(new Date(tDate.getTime() + 86_400_000), midLat, midLng).sunrise;
        // SunCalc's sunrise is the upper limb at -0.833°, still night by our
        // altitude check: step a minute at a time (capped for polar cases).
        for (let i = 0; i < 60 && getSun(nextSunrise, midLat, midLng).altDeg <= 0; i++) {
          nextSunrise = new Date(nextSunrise.getTime() + 60_000);
        }
        // The time input holds whole minutes and formatTimeInZone floors:
        // round up, later is still daylight.
        nextSunrise = new Date(Math.ceil(nextSunrise.getTime() / 60_000) * 60_000);
        const sunriseDateV = dateValueInZone(nextSunrise, destTz);
        const sunriseTimeV = formatTimeInZone(nextSunrise, destTz);
        button('night-sunrise-btn').textContent = tr('night_sunrise_btn', { time: sunriseTimeV });
        // One per search: a double tap is one intent, not two.
        let sunriseJumped = false;
        goToSunrise = () => {
          if (!sunriseJumped) {
            sunriseJumped = true;
            window.umami?.track('sunrise_jump', { stage: 'clicked' });
          }
          input('inp-date').value = sunriseDateV;
          input('inp-time').value = sunriseTimeV;
          handleSearch();
        };
      }

      const routes = await buildRoutes(startC, endC, searchStatus);
      if (stale()) return;
      if (!routes.length) throw noRouteError();

      const bbox = routesBbox(routes);
      let buildings: Awaited<ReturnType<typeof fetchBuildings>>['buildings'] = [];
      let trees: Awaited<ReturnType<typeof fetchVegetation>>['trees'] = [];
      let forests: Awaited<ReturnType<typeof fetchVegetation>>['forests'] = [];
      let leafFrac = 1;
      let buildingsStatus: Awaited<ReturnType<typeof fetchBuildings>>['status'] = 'ok';
      let buildingsSource: Awaited<ReturnType<typeof fetchBuildings>>['source'] = switzerland ? 'swisstopo' : 'osm';
      let vegStatus: Awaited<ReturnType<typeof fetchVegetation>>['status'] = 'ok';
      // The Overpass instance behind vegetation, which stands for buildings
      // too (same bbox). Null at night.
      let vegUpstream: string | null = null;
      // Never blocks the first render: vegetation always hits Overpass, up to
      // ~13s with retries, where buildings land in ~1s.
      let vegP: ReturnType<typeof fetchVegetation> | null = null;
      if (!night) {
        searchStatus(tr('status_buildings'));
        // Outside Switzerland, the basemap's building layer answers in ms
        // where Overpass takes ~11s. Read cell by cell along the routes;
        // anything short of a usable answer falls through to Overpass.
        let buildingsRes = null;
        if (!switzerland) {
          const tileRes = await fetchTileBuildings(
            routes,
            { bboxZoom, fitToBbox, glZoom, queryBuildingFeatures, viewportBbox, viewAt },
            (i: number, n: number) => searchStatus(tr('status_buildings_segment', { i: String(i), n: String(n) })),
          );
          if (tileRes.status === 'ok') buildingsRes = tileRes;
          // Back to the generic message after the per-segment ones.
          if (tileRes.status !== 'ok') searchStatus(tr('status_buildings'));
        }
        if (!buildingsRes) buildingsRes = await fetchBuildings(bbox, { switzerland });
        // Before the vegetation fetch: no Overpass call for a search nobody
        // will see.
        if (stale()) return;
        buildings = buildingsRes.buildings;
        buildingsStatus = buildingsRes.status;
        buildingsSource = buildingsRes.source;
        leafFrac = deciduousLeafFrac(tDate, midLat);
        searchStatus(tr('status_shadows', { n: String(buildings.length), r: String(routes.length) }));
        vegP = fetchVegetation(bbox);
      }
      const single = night || routes.length === 1;

      // renderAt dims the ratio bar on 'failed'; vegetation refines it.
      let heightState: ReturnType<typeof resolveHeightNoteState> = 'ok';
      // Sunny minus shady score, set by renderAt.
      let delta = 0;

      // On the first call vegStatus is still an optimistic 'ok', so only
      // 'partial' can be wrong: the vegetation continuation re-runs this.
      function updateHeightNote() {
        if (night) { showQualityNote(null); return; }
        heightState = resolveHeightNoteState(buildingsStatus, buildings.length, vegStatus);
        if (heightState === 'failed') {
          showQualityNote(tr('height_data_failed') + ' ' + tr('height_data_retry'), 'warn');
          return;
        }
        if (heightState === 'empty') {
          showQualityNote(tr('height_data_none'));
          return;
        }
        // 'partial' appends the vegetation line: the buildings note may
        // already be on screen, and replacing it would erase what was read.
        const stats = heightStats(buildings)!;
        const heightNoteKey = buildingsSource === 'swisstopo' ? 'height_data_note_swisstopo' : 'height_data_note_osm';
        const pct = Math.round(stats.pct * 100);
        const avgPart = stats.avgHeight == null ? '' : tr('height_data_avg_suffix', { avg: String(Math.round(stats.avgHeight)) });
        const lines = [
          tr(heightNoteKey),
          tr('height_data_line_stats', { n: String(stats.count), pct: String(pct), avgPart }),
        ];
        // Rounded pct, so "100% measured" never sits above "rest estimated".
        if (pct < 100) lines.push(tr('height_data_line_estimated'));
        if (heightState === 'partial') lines.push(tr('vegetation_failed'));
        showQualityNote(lines.join('\n'));
      }
      updateHeightNote();

      // At the rendered instant. Empty until weatherP resolves.
      function updateWeatherInfo(atDate: Date) {
        const w = weatherAt(hourlyWeather, atDate);
        const weatherEl = el('weather-note');
        if (w && w.cloudCover >= OVERCAST_PCT) {
          weatherEl.textContent = tr('weather_overcast', { pct: String(Math.round(w.cloudCover)) });
          weatherEl.classList.add('on');
        } else {
          weatherEl.classList.remove('on');
        }
        updateMapWeatherInfo(w);
      }

      const shareUrl = (atDate: Date) => location.pathname + '?' + buildShareQuery({
        start: { ...startC, label: startQ },
        end:   { ...endC,   label: endQ },
        date: dateValueInZone(atDate, destTz),
        time: formatTimeInZone(atDate, destTz),
        // Kept through scrubs, so a reload or a shared demo opens as the demo.
        onboarding: demo,
      });

      // Re-scores the fetched routes for one instant and redraws. Only the sun
      // moves, so this is cheap enough for every scrubber tick.
      function renderAt(atDate: Date) {
        const sunNow = getSun(atDate, midLat, midLng);
        updateSunInfo(sunNow, sunTimes, destTz, atDate);
        // Swiss routes only. Wins over the grazing-sun note: both say "trust
        // this less", the eclipse says why.
        const eclipse = switzerland && !night
          && isEclipseWindow(dateValueInZone(atDate, destTz), minutesInZone(atDate, destTz));
        document.getElementById('eclipse-note')?.classList.toggle('on', eclipse);
        document.getElementById('grazing-sun-note')
          ?.classList.toggle('on', !night && !eclipse && isGrazingSun(sunNow.altDeg));
        updateWeatherInfo(atDate);

        // The sun moves ~11° over a 45-min walk: each segment is scored at its
        // estimated arrival time.
        const sunSampler = makeSunSampler(atDate, midLat, midLng);
        routes.forEach(rt => {
          const { score, segShade } = scoreRoute(rt, buildings, trees, sunSampler, leafFrac, forests);
          rt.sunScore = score;
          rt.segShade = segShade;
        });
        routes.sort((a, b) => b.sunScore - a.sunScore);

        let sunnyRt = routes[0];
        const shadyRt = routes[routes.length - 1];
        // Night collapses the sunny/shady distinction: show only the shortest route.
        if (night) sunnyRt = routes.reduce((a, b) => (b.distance < a.distance ? b : a));
        delta = Math.round((sunnyRt.sunScore - shadyRt.sunScore) * 100);

        displayRoutes(startC, endC, sunnyRt, single ? null : shadyRt);
        showResults(sunnyRt, shadyRt, single, night, heightState === 'failed');

        // The URL always holds the instant on screen, scrubbed or not.
        history.replaceState(null, '', shareUrl(atDate));
      }

      // A search started from the empty app pushes its own entry so Back
      // undoes it, before renderAt's replaceState can touch the empty app's.
      // Later searches and scrubs replace it; a shared link pushes nothing.
      if (!urlHasSearch()) {
        history.pushState(null, '', shareUrl(tDate));
        searchEntryPushed = true;
      }
      searchShown = true;
      // The demo button is for the empty app only.
      el('onboarding-btn').classList.add('off');
      renderAt(tDate);
      notifySearchSucceeded();
      // Here, not where goToSunrise is built: buildRoutes can still throw
      // before the note is ever seen.
      if (night) window.umami?.track('sunrise_jump', { stage: 'shown' });
      let currentInstant = tDate;
      // Captured now: the search event fires later, after vegetation.
      const msToFirstRender = Math.round(performance.now() - searchStart);

      // Once per search: right away at night, else once vegetation settles
      // and status and delta are final.
      const trackSearch = () => window.umami?.track('search', {
        status: heightState,
        source: buildingsSource,
        country: startC.countryCode,
        buildings: buildings.length,
        ms: msToFirstRender,
        night, single,
        delta,
        eclipse: eclipseDay,
        ...(vegUpstream ? { upstream: vegUpstream } : {}),
        // The demo is the same search for everyone: kept apart from real ones.
        ...(demo ? { onboarding: true } : {}),
      });

      hourlyWeather = await weatherP;
      if (stale()) return;
      // At the current instant, a scrub may have moved on. No renderAt:
      // weather changes neither scores nor the map.
      updateWeatherInfo(currentInstant);

      const preselect = single ? 'sunny' : preselectTab({
        altDeg: sun.altDeg,
        // The searched instant, not a scrubbed one.
        temperature: weatherAt(hourlyWeather, tDate)?.temperature ?? null,
        month: tDate.getUTCMonth(),
        lat: midLat,
      });
      setActiveTab(preselect);
      setActiveRoute(preselect);
      searchStatus(null);

      // Sunrise to sunset. Minutes are offsets from the searched time, which
      // sidesteps DST parsing.
      if (night) {
        hideScrubber();
      } else {
        const initialMinutes = minutesInZone(tDate, destTz);
        // One 'scrub' per search, on the first move.
        let scrubbed = false;
        // Kept apart from 'scrub': dragging and the eclipse shortcut are two
        // separate questions.
        let jumped = false;
        showScrubber({
          min: minutesInZone(sunTimes.sunrise, destTz),
          max: minutesInZone(sunTimes.sunset, destTz),
          value: initialMinutes,
          label: fmtHm(initialMinutes),
          mark: eclipseDay
            ? { minutes: ECLIPSE_2026.maxMin, label: tr('eclipse_max_label', { time: fmtHm(ECLIPSE_2026.maxMin) }) }
            : null,
        }, (minutes: number, source?: string) => {
          if (source === 'mark') {
            if (!jumped) {
              jumped = true;
              window.umami?.track('eclipse_jump');
            }
          } else if (!scrubbed) {
            scrubbed = true;
            window.umami?.track('scrub');
          }
          // So the vegetation pass re-renders where the user scrubbed to.
          currentInstant = new Date(tDate.getTime() + (minutes - initialMinutes) * 60_000);
          renderAt(currentInstant);
          setScrubberLabel(fmtHm(minutes));
          const active = (document.querySelector<HTMLButtonElement>('.tab-btn.active')?.dataset.tab ?? 'sunny') as 'sunny' | 'shady';
          setActiveTab(active);
          setActiveRoute(active);
        });
      }

      if (vegP) {
        vegP.then(vegRes => {
          // Dropped if a newer search started meanwhile.
          if (mySearchGen !== searchGeneration) return;
          trees = vegRes.trees;
          forests = vegRes.forests;
          vegStatus = vegRes.status;
          vegUpstream = vegRes.upstream;
          updateHeightNote();
          renderAt(currentInstant);
          // displayRoutes redraws both routes at full opacity: re-apply the
          // active tab.
          const active = (document.querySelector<HTMLButtonElement>('.tab-btn.active')?.dataset.tab ?? 'sunny') as 'sunny' | 'shady';
          setActiveTab(active);
          setActiveRoute(active);
          trackSearch();
        });
      } else {
        trackSearch();
      }

    } catch (err) {
      // Undone or superseded: its failure is nobody's news.
      if (stale()) return;
      setStatus(null);
      // The user gets a sentence; the technical detail stays on the error for
      // the console and Sentry.
      const { code, role } = (err ?? {}) as CodedError;
      // Codes whose error carries only technical detail: translated here.
      const TECHNICAL = {
        RATE_LIMIT: 'error_rate_limit',
        TOO_FAR: 'error_too_far',
        ROUTE_FAILED: 'error_route_failed',
        ROUTING_UNAVAILABLE: 'error_routing_unavailable',
      } as const;
      // Codes whose message is already the sentence: shown as-is.
      const READY = new Set(['ADDRESS_NOT_FOUND', 'POSITION_UNKNOWN', 'NO_ROUTE']);
      const technicalKey = code ? TECHNICAL[code as keyof typeof TECHNICAL] : undefined;
      if (technicalKey) {
        showToast(tr(technicalKey));
      } else if (code && READY.has(code) && err instanceof Error) {
        showToast(err.message);
      } else {
        showToast(tr('error_prefix') + (err instanceof Error ? err.message : String(err)));
      }
      console.error(err);
      // Never send err.message: it can embed the address the user typed.
      window.umami?.track('search', {
        status: 'error',
        code: code ?? 'unknown',
        ...(role ? { field: role } : {}),
        ms: Math.round(performance.now() - searchStart),
      });
    } finally {
      // A stale search leaves the buttons to whoever made it stale.
      if (!stale()) setSearchBusy(false);
    }
  }

  // Geolocation error codes are numeric, ours (reverseGeocode) are strings.
  const GEO_CODES: Record<number, string> = { 1: 'GEO_DENIED', 2: 'GEO_UNAVAILABLE', 3: 'GEO_TIMEOUT' };
  function handleGeoError(err: unknown, source: 'field' | 'locate') {
    const code = (err as { code?: number | string })?.code;
    if (code === 1) {
      showToast(tr('error_geo_denied'));
    } else if (code === 'POSITION_UNKNOWN' && err instanceof Error) {
      showToast(err.message);
    } else {
      showToast(tr('error_geo_timeout'));
    }
    console.error(err);
    window.umami?.track('geo_error', {
      code: typeof code === 'number' ? (GEO_CODES[code] ?? 'unknown') : (code ?? 'unknown'),
      source,
    });
  }

  async function fillFromGeo(ac: ReturnType<typeof initAutocomplete>, role: 'start' | 'end', btnId: string) {
    const btn = button(btnId);
    btn.disabled = true;
    btn.classList.add('loading');
    setStatus(tr('geo_loading'));
    try {
      const pos = await new Promise<GeolocationPosition>((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 10000 });
      });
      const { short: label, countryCode } = await reverseGeocode(pos.coords.latitude, pos.coords.longitude);
      const lat = pos.coords.latitude, lng = pos.coords.longitude;
      ac.setPlace({ lat, lng, label, countryCode });
      setPreviewPin(role, { lat, lng });
      syncInputState();
      saveLastPosition(lat, lng);
      setStatus(null);
    } catch (err: unknown) {
      setStatus(null);
      handleGeoError(err, 'field');
    } finally {
      btn.disabled = false;
      btn.classList.remove('loading');
    }
  }

  button('geo-start').addEventListener('click', () => fillFromGeo(startAC, 'start', 'geo-start'));
  button('geo-end').addEventListener('click',   () => fillFromGeo(endAC,   'end',   'geo-end'));

  // A point picked on the map (openPickPopup in map.js). The coordinates fill
  // the field at once so the point is usable, then the address replaces them.
  // A failed lookup keeps them, with no country: a Swiss route uses Overpass.
  const pickToken = { start: 0, end: 0 };

  async function fillFromMap(role: 'start' | 'end', lat: number, lng: number) {
    const ac = role === 'start' ? startAC : endAC;
    const token = ++pickToken[role];
    ac.setPlace({ lat, lng, label: `${lat.toFixed(5)}, ${lng.toFixed(5)}` });
    setPreviewPin(role, { lat, lng }, { pan: false });
    syncInputState();
    window.umami?.track('point_picked', { role, method: 'map' });
    try {
      const { short, countryCode } = await reverseGeocode(lat, lng);
      // Dropped if a newer pick on this field has started.
      if (token !== pickToken[role]) return;
      ac.setPlace({ lat, lng, label: short, countryCode });
      syncInputState();
    } catch { /* the coordinates stay in the field */ }
  }

  window.addEventListener('map-point-picked', (e: Event) => {
    const { role, lat, lng } = (e as CustomEvent<{ role: 'start' | 'end'; lat: number; lng: number }>).detail;
    fillFromMap(role, lat, lng);
  });

  function clearField(ac: ReturnType<typeof initAutocomplete>, role: 'start' | 'end', inputId: string) {
    ac.clear();
    clearPreviewPin(role);
    syncInputState();
    input(inputId).focus();
  }
  button('clear-start').addEventListener('click', () => clearField(startAC, 'start', 'inp-start'));
  button('clear-end').addEventListener('click',   () => clearField(endAC,   'end',   'inp-end'));

  let swapAngle = 0;
  function swapEndpoints() {
    const a = startAC.getState();
    const b = endAC.getState();
    startAC.setState(b);
    endAC.setState(a);
    swapPreviewPins();
    syncInputState();
    // Accumulate the angle so the transition replays in full on every click.
    swapAngle += 180;
    el<HTMLElement>('swap-btn').querySelector<HTMLElement>('.swap-ico')!
      .style.transform = `rotate(${swapAngle}deg)`;
  }
  button('swap-btn').addEventListener('click', swapEndpoints);

  // "Leave now" resets the date/time first, so a stale value is never reused.
  // A later departure goes through the popover.
  function setDepartureNow() {
    const n = new Date();
    input('inp-date').value = localDateValue(n);
    input('inp-time').value = n.toTimeString().slice(0, 5);
  }
  function leaveNow() {
    setDepartureNow();
    handleSearch();
  }

  const departPopover = el('depart-popover');
  const departToggle  = button('depart-toggle');

  // focus: false for the demo: on a phone, focusing the date opens the picker.
  function openDepartPopover({ focus = true }: { focus?: boolean } = {}) {
    departPopover.classList.add('open');
    departToggle.setAttribute('aria-expanded', 'true');
    if (focus) input('inp-date').focus();
  }
  function closeDepartPopover() {
    departPopover.classList.remove('open');
    departToggle.setAttribute('aria-expanded', 'false');
  }
  function toggleDepartPopover() {
    if (departPopover.classList.contains('open')) closeDepartPopover();
    else openDepartPopover();
  }

  button('search-btn').addEventListener('click', leaveNow);
  departToggle.addEventListener('click', (e: MouseEvent) => { e.stopPropagation(); toggleDepartPopover(); });
  button('depart-confirm').addEventListener('click', () => handleSearch());
  document.addEventListener('click', (e: MouseEvent) => {
    if (!departPopover.classList.contains('open')) return;
    const target = e.target as Node;
    if (departPopover.contains(target) || departToggle.contains(target)) return;
    closeDepartPopover();
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Escape') closeDepartPopover(); });

  ['inp-start', 'inp-end'].forEach(id =>
    input(id).addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') handleSearch(); })
  );

  // renderAt keeps location.href in sync with the search.
  button('share-btn').addEventListener('click', async () => {
    const url = location.href;
    if (navigator.share) {
      window.umami?.track('share', { method: 'native' });
      try { await navigator.share({ title: document.title, url }); }
      catch { /* user dismissed the share sheet */ }
    } else {
      window.umami?.track('share', { method: 'clipboard' });
      await navigator.clipboard.writeText(url);
      showToast(tr('toast_link_copied'), 'success');
    }
  });

  // Shared link, or Forward onto a search entry. False without a complete
  // search in the URL; a partial one still fills what it has.
  async function restoreFromUrl(): Promise<boolean> {
    const search = location.search;
    const shared = parseShareQuery(search);
    if (shared.date) input('inp-date').value = shared.date;
    if (shared.time) input('inp-time').value = shared.time;
    if (shared.start) { startAC.setPlace(shared.start); setPreviewPin('start', shared.start); }
    if (shared.end)   { endAC.setPlace(shared.end);     setPreviewPin('end',   shared.end); }
    syncInputState();
    if (!shared.start || !shared.end) return false;
    // Links carry no country: resolve it so a Swiss link uses swisstopo.
    const [startCC, endCC] = await Promise.all([
      reverseGeocode(shared.start.lat, shared.start.lng).then(r => r.countryCode).catch(() => undefined),
      reverseGeocode(shared.end.lat, shared.end.lng).then(r => r.countryCode).catch(() => undefined),
    ]);
    // Back again meanwhile: running it now would push an unwanted entry.
    if (location.search !== search) return true;
    startAC.setPlace({ ...shared.start, countryCode: startCC });
    endAC.setPlace({ ...shared.end, countryCode: endCC });
    if (shared.onboarding) window.umami?.track('onboarding', { via: 'link' });
    handleSearch({ onboarding: shared.onboarding });
    return true;
  }

  // Run like a typed search, so Back returns to the empty app. Already Swiss:
  // no reverse geocode.
  function startOnboarding() {
    window.umami?.track('onboarding', { via: 'button' });
    const start = { ...ONBOARDING.start, label: tr('onboarding_from') };
    const end = { ...ONBOARDING.end, label: tr('onboarding_to') };
    input('inp-date').value = ONBOARDING.date;
    input('inp-time').value = ONBOARDING.time;
    startAC.setPlace(start);
    endAC.setPlace(end);
    setPreviewPin('start', start, { pan: false });
    setPreviewPin('end', end, { pan: false });
    syncInputState();
    handleSearch({ onboarding: true });
  }
  el('onboarding-btn').addEventListener('click', (e: MouseEvent) => {
    // A modified click opens the link in a new tab, as any link would.
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    // Or the outside-click handler closes the popover the demo just opened.
    e.stopPropagation();
    startOnboarding();
  });

  // Typing leaves the demo for the empty app. Landed on as a link, there is
  // none underneath: the entry becomes one.
  function leaveOnboarding() {
    if (!onboarding) return;
    resetSearch();
    if (searchEntryPushed) {
      skipNextPop = true;
      history.back();
    } else {
      history.replaceState(null, '', location.pathname);
    }
  }
  ['inp-start', 'inp-end'].forEach(id => input(id).addEventListener('focus', leaveOnboarding));

  // A link with a search is about to show results: no demo button over them.
  el('onboarding-btn').classList.toggle('off', urlHasSearch());

  if (!(await restoreFromUrl())) {
    if (isStandalone()) {
      // Installed app: prefill "start" from the phone's position, else
      // center like a browser tab.
      prefillFromRelaunch().then((filled) => { if (!filled) initInitialMapCenter(); });
    } else {
      initInitialMapCenter();
    }
  }

  // Standalone only, so a permission prompt is expected. Silent on failure:
  // nothing was asked for this session.
  async function prefillFromRelaunch(): Promise<boolean> {
    try {
      const pos = await new Promise<GeolocationPosition>((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 8000 });
      });
      const lat = pos.coords.latitude, lng = pos.coords.longitude;
      const { short: label, countryCode } = await reverseGeocode(lat, lng);
      startAC.setPlace({ lat, lng, label, countryCode });
      setPreviewPin('start', { lat, lng });
      syncInputState();
      saveLastPosition(lat, lng);
      return true;
    } catch {
      // Denied, timed out or reverse geocode failed: try the last known fix.
      const cached = getLastPosition();
      if (!cached) return false;
      try {
        const { short: label, countryCode } = await reverseGeocode(cached.lat, cached.lng);
        startAC.setPlace({ lat: cached.lat, lng: cached.lng, label, countryCode });
        setPreviewPin('start', cached);
        syncInputState();
        return true;
      } catch {
        return false;
      }
    }
  }

  // A better first view than the Lausanne default, without prompting or
  // showing the location dot: the position if permission is already granted,
  // else the browser's timezone (see tzCenters.js).
  async function initInitialMapCenter() {
    try {
      const status = await navigator.permissions?.query({ name: 'geolocation' as PermissionName });
      if (status?.state === 'granted') {
        const pos = await new Promise<GeolocationPosition>((resolve, reject) => {
          navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 5000 });
        });
        centerMap(pos.coords.latitude, pos.coords.longitude, 14);
        return;
      }
    } catch {
      // No Permissions API (older Safari), or the fix failed: use the timezone.
    }
    const tzCenter = TZ_CENTERS[Intl.DateTimeFormat().resolvedOptions().timeZone];
    if (tzCenter) centerMap(tzCenter[0], tzCenter[1], 10);
  }

  // The map's locate control: never fills a field, and the only place the
  // location dot appears.
  window.addEventListener('locate-me', async () => {
    setStatus(tr('geo_loading'));
    try {
      const pos = await new Promise<GeolocationPosition>((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 10000 });
      });
      showMyLocation(pos.coords.latitude, pos.coords.longitude, tr('my_location_title'));
      saveLastPosition(pos.coords.latitude, pos.coords.longitude);
      setStatus(null);
    } catch (err: unknown) {
      setStatus(null);
      handleGeoError(err, 'locate');
    }
  });

  const drawer  = el('about-drawer');
  const overlay = el('about-overlay');

  function openAbout() {
    drawer.classList.add('open');
    overlay.classList.add('on');
    el('app').setAttribute('inert', '');
    el('about-close').focus();
    // Its own entry, so Back and swipe-back close the panel. No URL argument:
    // the share query stays.
    history.pushState({ nav: 'about' }, '');
  }
  // The DOM half of the close: idempotent, and reused straight from popstate.
  function closeAbout() {
    if (!drawer.classList.contains('open')) return;
    drawer.classList.remove('open');
    overlay.classList.remove('on');
    el('app').removeAttribute('inert');
    el('about-btn').focus();
  }
  // Manual dismiss goes through history, so the pushed entry is reclaimed.
  function dismissAbout() {
    if (drawer.classList.contains('open')) history.back();
  }

  // role="dialog" alone doesn't trap focus.
  function trapAboutFocus(e: KeyboardEvent) {
    if (e.key !== 'Tab' || !drawer.classList.contains('open')) return;
    const focusable = Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  el('about-btn').addEventListener('click', openAbout);
  el('about-close').addEventListener('click', dismissAbout);
  overlay.addEventListener('click', dismissAbout);
  document.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Escape') dismissAbout(); });
  document.addEventListener('keydown', trapAboutFocus);

  // Back from a search, without a reload. The map view stays, and focus
  // stays out of the fields so no keyboard pops up.
  function resetSearch() {
    // A search still in flight, and any vegetation pass, is now stale.
    searchGeneration++;
    searchShown = false;
    // Out of the demo too: its note and date go, the button comes back.
    onboarding = false;
    hideAppDescription();
    hideOnboardingNote();
    closeDepartPopover();
    el('onboarding-btn').classList.remove('off');
    clearMap();
    startAC.clear();
    endAC.clear();
    // A reverse geocode still running for a map pick must not refill a field.
    pickToken.start++;
    pickToken.end++;
    syncInputState();
    setDepartureNow();
    hideResults();
    hideScrubber();
    showQualityNote(null);
    setStatus(null);
    // Rather than waiting on the upstreams of a search that no longer counts.
    setSearchBusy(false);
    sunInfoBtn.classList.remove('on', 'day', 'night', 'expanded');
    sunInfoBtn.setAttribute('aria-expanded', 'false');
    el('map-sun-info-weather').textContent = '';
  }

  // Back peels one layer per press: the about panel, then the search. The
  // results drawer has no entry, it has its own gesture.
  // The URL tells where Back landed, never event.state: renderAt's
  // replaceState(null) wipes it on every scrub. A search entry with nothing
  // on screen means Forward.
  window.addEventListener('popstate', () => {
    // leaveOnboarding's own step back: the app is already reset.
    if (skipNextPop) {
      skipNextPop = false;
      return;
    }
    // No entry of its own, but a Back shouldn't leave it hanging open.
    closeDepartPopover();
    if (drawer.classList.contains('open')) {
      closeAbout();
      return;
    }
    const inUrl = urlHasSearch();
    if (!inUrl && searchShown) {
      // loading: a search runs (read before the reset frees the button) and
      // nothing is drawn yet.
      const loading = button('search-btn').disabled && !el('results').classList.contains('on');
      window.umami?.track('back_reset', { loading });
      resetSearch();
    } else if (inUrl && !searchShown) {
      restoreFromUrl();
    }
  });

</script>

</body>
</html>
