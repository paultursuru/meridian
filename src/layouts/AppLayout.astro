---
import '../styles/main.css';
import type { Lang } from '../lib/i18n';
import AppHead from '../components/app/AppHead.astro';
import Header from '../components/app/Header.astro';
import SearchPanel from '../components/app/SearchPanel.astro';
import MapArea from '../components/app/MapArea.astro';
import AboutDrawer from '../components/app/AboutDrawer.astro';
import TimeScrubber from '../components/app/TimeScrubber.astro';
import ResultsPanel from '../components/app/ResultsPanel.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <AppHead lang={lang} />
</head>
<body>

<div id="app">
  <Header lang={lang} />
  <SearchPanel lang={lang} />
  <MapArea lang={lang} />
</div>

<div id="status" role="status" aria-live="polite"></div>

<AboutDrawer lang={lang} />
<TimeScrubber lang={lang} />
<ResultsPanel lang={lang} />

<script>
  import '../app/main';
</script>

</body>
</html>
