---
// The about page, in each language, on the same shell as the content pages.
import ContentLayout from './ContentLayout.astro';
import AboutContent from '../components/AboutContent.astro';
import githubIcon from '../icons/github.svg?raw';
import { translations, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<ContentLayout lang={lang} title={t.about_title} description={t.about_meta_description} path="about/" translated bodyClass="about-page">
  <AboutContent lang={lang} heading="h1" title={t.aria_about} />
  <p class="about-page-links">
    <a href="https://github.com/paultursuru/meridian" target="_blank" rel="noopener" class="about-link github-link">
      <Fragment set:html={githubIcon} />
      GitHub
    </a>
  </p>
</ContentLayout>

<style is:global>
  /* The pane is sized for the app's drawer: on the page, the page's own text. */
  .about-page .about-pane p { font-size: inherit; color: inherit; line-height: inherit; }
  .about-page .about-tagline { font-size: 1.05rem; }
  .about-page .about-opensource { font-size: 0.95rem; }
  .about-page .about-opensource a { color: var(--shadec); }
  .about-page-links { margin-top: 2rem; }
  .about-page main a.github-link { color: var(--sunc); text-decoration: none; }
</style>
