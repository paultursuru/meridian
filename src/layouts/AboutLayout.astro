---
import '../styles/main.css';
import { translations, LANGS, langPath, langUrl, type Lang } from '../lib/i18n';
import AboutContent from '../components/AboutContent.astro';
import githubIcon from '../icons/github.svg?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const pageUrl = (l: Lang) => langUrl(l, 'about/');

---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{t.about_title}</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0e120a" />
  <meta name="description" content={t.about_meta_description} />
  <link rel="canonical" href={pageUrl(lang)} />
  {LANGS.map(l => <link rel="alternate" hreflang={l} href={pageUrl(l)} />)}
  <link rel="alternate" hreflang="x-default" href={pageUrl('fr')} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl(lang)} />
  <meta property="og:title" content={t.about_title} />
  <meta property="og:description" content={t.about_meta_description} />
  <meta property="og:image" content="https://meridian-way.ch/meridian-way-og.png" />
  <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="3ed0ad98-8924-4e14-aa5b-6afe5d3dc7ac" data-domains="meridian-way.ch" data-auto-pageview="false" data-performance="false"></script>
</head>
<body class="about-page">

<div id="about-page-wrap">
  <nav id="about-page-nav">
    <a href={langUrl(lang)} class="back-link">{t.about_back}</a>
    <div id="about-page-lang">
      {LANGS.map(l => (
        <a class:list={['lang-link', { active: lang === l }]} href={pageUrl(l)}>{l.toUpperCase()}</a>
      ))}
    </div>
  </nav>

  <main id="about-page-content">
    <AboutContent lang={lang} allLangs={false} />

    <div id="about-page-links">
      <a href="https://github.com/paultursuru/meridian" target="_blank" rel="noopener" class="about-link github-link">
        <Fragment set:html={githubIcon} />
        GitHub
      </a>
    </div>
    <div class="footer-links">
      <a href={langPath(lang, 'about')} class="footer-link">{t.aria_about}</a>
      <span class="footer-link">-</span>
      <a href={langPath(lang, 'privacy')} class="footer-link">{t.about_privacy}</a>
    </div>
  </main>
</div>

<style>
  body.about-page {
    background: #0e120a;
    color: #d8dbc8;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 2rem 1rem;
  }
  #about-page-wrap {
    width: 100%;
    max-width: 560px;
  }
  #about-page-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(240,242,160,0.13);
  }
  .back-link {
    color: #f0f2a0;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back-link:hover { text-decoration: underline; }
  #about-page-lang {
    display: flex;
    gap: 0.5rem;
  }
  .lang-link {
    color: rgba(216,219,200,0.6);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 10px;
    border: 1.5px solid rgba(240,242,160,0.2);
    border-radius: 6px;
    transition: all 0.15s;
  }
  .lang-link.active { background: #f0f2a0; border-color: #f0f2a0; color: #0e120a; }
  .lang-link:hover:not(.active) { border-color: rgba(240,242,160,0.5); color: #f0f2a0; }
  #about-page-links {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(240,242,160,0.13);
  }
</style>

<!-- Bundle par Astro (pas is:inline) : la CSP interdit les scripts inline. -->
<script>
  import { trackPageview } from '../lib/analytics.js';
  trackPageview();
</script>

</body>
</html>
