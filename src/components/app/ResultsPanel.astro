---
import { translations, type Lang } from '../../lib/i18n';
import RoutePane from './RoutePane.astro';
import shareIcon from '../../icons/share.svg?raw';
import chevronLeftIcon from '../../icons/chevron-left.svg?raw';
import cloudIcon from '../../icons/cloud.svg?raw';
import lowSunIcon from '../../icons/low-sun.svg?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<div id="results" role="status" aria-live="polite">
  <div id="drawer-handle" aria-label={t.aria_drawer_toggle} role="button" tabindex="0">
    <div id="drawer-bar"></div>
  </div>
  <button id="share-btn" type="button" title={t.share_btn_title} aria-label={t.share_btn_title}>
    <Fragment set:html={shareIcon} />
    <span>{t.share_btn_label}</span>
  </button>
  <div id="night-note">
    <p>{t.night_note}</p>
    <button id="night-sunrise-btn" type="button"></button>
  </div>
  <div id="eclipse-note">{t.eclipse_note}</div>
  <div id="single-route-note">{t.single_route_note}</div>
  <div id="tabs" role="tablist">
    <button class="tab-btn shady"  id="tab-btn-shady" data-tab="shady" role="tab" aria-selected="false" aria-controls="tab-shady"><span class="side-dot shade" aria-hidden="true"></span>{t.tab_shady}</button>
    <button class="tab-btn active" id="tab-btn-sunny" data-tab="sunny" role="tab" aria-selected="true"  aria-controls="tab-sunny"><span class="side-dot sun" aria-hidden="true"></span>{t.tab_sunny}</button>
  </div>
  <!-- Expanded on mobile, only this part scrolls: the tabs and Share stay in
       view above it. The side panel scrolls as a whole (display: contents). -->
  <div id="drawer-body">
    <RoutePane lang={lang} kind="sunny" active />
    <RoutePane lang={lang} kind="shady" />
    <!-- Under the routes, so the folded drawer keeps its shade/sun bar: on
         mobile the badges over the scrubber point here. The side panel lays
         these out on its own (display: contents), weather first. -->
    <div id="hour-notes">
      <h2 id="hour-notes-title">{t.hour_notes_title}</h2>
      <p id="hour-weather"></p>
      <div id="weather-note" class="hour-note"><Fragment set:html={cloudIcon} /><span id="weather-note-text"></span></div>
      <div id="grazing-sun-note" class="hour-note"><Fragment set:html={lowSunIcon} /><span>{t.grazing_sun_note}</span></div>
      <div id="similar-routes-note" class="hour-note"><span>{t.similar_routes_note}</span></div>
    </div>
    <div id="quality-note"></div>
  </div>
</div>

<!-- Desktop only: folds the side panel away. A sibling of #results, which
     clips its overflow, so it stays reachable once the panel has slid out. -->
<button id="panel-toggle" type="button" aria-controls="results" aria-expanded="true" title={t.panel_toggle_title} aria-label={t.panel_toggle_title} set:html={chevronLeftIcon} />
